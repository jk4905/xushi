page{background:#eaf0d9;color:#173d2b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;font-size:16px;line-height:1.6;--green:#173d2b;--muted:#52664b;--paper:#f3f6e8;--lime:#e2ed9c;--line:#c5cfb2}
view,text,button,input,textarea{box-sizing:border-box}button{font:inherit;line-height:1.45;border-radius:16px;min-height:48px;display:flex;align-items:center;justify-content:center;margin:0;padding:12px 18px;white-space:normal;overflow-wrap:anywhere}button::after{border:0}button[disabled]{opacity:.5}button:active{opacity:.8}.page{padding:24px 20px calc(24px + env(safe-area-inset-bottom));min-height:100vh}.with-tabs{padding-bottom:calc(100px + env(safe-area-inset-bottom))}.with-action{padding-bottom:calc(174px + env(safe-area-inset-bottom))}.eyebrow{font-size:12px;letter-spacing:3px;color:#52664b;font-weight:600}.title{font-size:30px;line-height:1.25;font-weight:600;letter-spacing:-.6px;margin:8px 0 12px;overflow-wrap:anywhere}.subtitle,.muted{color:#52664b;font-size:14px}.subtitle{margin-bottom:24px}.card{background:#f3f6e8;border:1px solid #c5cfb2;border-radius:22px;padding:20px;margin-bottom:16px}.section-title{font-size:19px;font-weight:600;margin:28px 0 12px}.row{display:flex;align-items:center;gap:12px;min-height:56px;padding:14px 0;border-bottom:1px solid #d7dec8}.row:last-child{border:0}.row-main{flex:1;min-width:0}.row-title{font-size:17px;font-weight:500;overflow-wrap:anywhere}.pill{display:inline-block;padding:3px 10px;border-radius:20px;background:#e2ed9c;font-size:12px}.primary{background:#173d2b;color:#fff;width:100%;font-weight:600}.secondary{background:#f3f6e8;color:#173d2b;border:1px solid #c5cfb2;width:100%}.text-button{background:transparent;color:#173d2b;font-size:14px;padding:10px 12px;min-height:44px}.danger{color:#9b3c2b}.field{margin:18px 0}.label{display:block;font-size:15px;font-weight:600;margin-bottom:8px}.input,.textarea{background:#fffdf6;border:1px solid #bac7a8;border-radius:12px;width:100%;padding:14px;color:#173d2b;font-size:16px}.input{height:52px}.textarea{min-height:140px;line-height:1.7}.error{background:#fff0e8;color:#873423;padding:14px 16px;border-radius:12px;font-size:14px;margin:12px 0;overflow-wrap:anywhere}.empty{text-align:center;padding:40px 12px}.empty .primary{margin-top:24px}.bottom-action{position:fixed;left:0;right:0;bottom:calc(65px + env(safe-area-inset-bottom));z-index:30;padding:10px 20px;background:#eaf0d9;border-top:1px solid #c5cfb2}.editor-action{bottom:0;padding-bottom:calc(12px + env(safe-area-inset-bottom))}.editor-page{padding-bottom:calc(120px + env(safe-area-inset-bottom))}.action-caption{font-size:12px;color:#52664b;text-align:center;margin-bottom:6px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.section-head .section-title{margin:16px 0}.inline-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.separator{height:1px;background:#c5cfb2;margin:20px 0}.search{margin-bottom:20px}.segmented{display:flex;padding:4px;background:#dce5cc;border-radius:15px;margin:16px 0;gap:4px}.segmented button{flex:1;background:transparent;font-size:14px;min-height:44px;padding:8px}.segmented button.active{background:#f3f6e8}.check{width:26px;height:26px;border:1.5px solid #839474;border-radius:9px;flex-shrink:0;display:flex;align-items:center;justify-content:center}.check.checked{background:#173d2b;color:#fff;border-color:#173d2b}.small{font-size:12px}.link{color:#173d2b;text-decoration:underline}.dish-image{width:56px;height:56px;flex-shrink:0}.keyboard-action{position:static;margin-top:20px;padding:0;border:0;background:transparent}.long-text{white-space:pre-wrap;overflow-wrap:anywhere}

/* WeChat v2 gives default buttons a fixed width; page roles determine their width here. */
.page .primary,.cook-shell .primary,.page .secondary,.cook-shell .secondary,.page .ingredient,.page .recipe-row,.page .menu-choice,.cook-shell .materials-toggle{width:100%}
.page .text-button,.cook-shell .text-button,.cook-shell .dish-chip{width:auto;flex-shrink:0}

/* Touch feedback never delays a handler or moves surrounding layout. */
.primary,.secondary{transition:transform 110ms ease-out,opacity 110ms ease-out,background-color 180ms ease-out}
.primary.button-hover,.secondary.button-hover{transform:scale(.98);opacity:.88}
.segmented button{transition:background-color 180ms ease-out,color 180ms ease-out}
@media(prefers-reduced-motion:reduce){view,text,button,image,scroll-view{animation:none!important;transition:none!important}.primary.button-hover,.secondary.button-hover,.dish-chip.chip-pressed{transform:none}}
