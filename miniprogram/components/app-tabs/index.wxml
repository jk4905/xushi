<view wx:if="{{!keyboardOpen}}" class="tabs"><view class="tab-indicator {{active === 'library' ? 'at-library' : ''}} {{slideFrom ? 'slide-from-'+slideFrom : ''}}" style="animation-delay:-{{slideDelay}}ms" bindanimationend="slideEnd" aria-hidden="true"/><button class="tab {{active === 'home' ? 'selected' : ''}}" data-tab="home" bindtap="go" hover-class="tab-pressed" hover-stay-time="80" aria-label="做饭，{{active === 'home' ? '当前栏目' : '切换栏目'}}"><image class="tab-icon" src="/assets/tab-cook.png" aria-hidden="true"/>做饭</button><button class="tab {{active === 'library' ? 'selected' : ''}}" data-tab="library" bindtap="go" hover-class="tab-pressed" hover-stay-time="80" aria-label="菜谱，{{active === 'library' ? '当前栏目' : '切换栏目'}}"><image class="tab-icon" src="/assets/tab-book.png" aria-hidden="true"/>菜谱</button></view>
