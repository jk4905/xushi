<view class="page with-action">
 <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
 <block wx:if="{{meal}}"><view class="eyebrow">{{meal.title}}</view><view class="section-head"><view class="title">买菜清单</view><text class="count">{{prepared}}<text class="muted"> / {{total}}</text></text></view><view class="subtitle">轻点勾选；再点取消。长按可标记家里已有。</view>
 <view wx:if="{{missing.length}}" class="notice">尚未录入材料：<text wx:for="{{missing}}" wx:key="*this">{{index ? '、' : ''}}{{item}}</text>。请按原菜谱准备，清单不包含这些菜的用料。</view>
 <view class="list card"><button wx:for="{{items}}" wx:key="id" class="ingredient {{item.checked ? 'is-ready' : ''}}" hover-class="ingredient-pressed" hover-stay-time="80" data-index="{{index}}" bindtap="toggle" bindlongpress="homeStock" aria-label="{{item.name}}，{{item.quantity || '用量未记录'}}，{{item.checked ? '已备齐，点按取消' : '未备齐，点按勾选'}}" disabled="{{meal.status !== 'planned'}}"><view class="check {{item.checked ? 'checked' : ''}}" aria-hidden="true"><text class="check-mark">✓</text></view><view class="row-main"><view class="row-title">{{item.name}}</view><view class="muted small">{{item.dish}}</view></view><view class="quantity">{{item.quantity || '未记用量'}}<view class="small muted">{{item.status === 'at-home' ? '家里已有' : item.checked ? '已买好' : ''}}</view></view></button><view wx:if="{{!items.length}}" class="empty muted">这餐还没有已选用的材料。可在本餐用料中补充。</view></view>
 <view class="section-head"><text class="muted">{{pending ? pending+' 项材料尚待取舍' : '按本餐用料准备即可'}}</text><button class="text-button" bindtap="adjust">本餐用料 ›</button></view>
 <view wx:if="{{meal.status === 'planned'}}" class="bottom-action"><view class="action-caption">{{prepared === total && total ? '已备齐，可以开火了' : '准备妥当后，直接打开完整做法'}}</view><button class="primary" hover-stay-time="80" bindtap="start">开始做饭 →</button></view><view wx:else class="card muted">这餐{{meal.status === 'completed' ? '已完成' : '已取消'}}，记录只读。可在全部餐次中恢复。</view></block>
 <button wx:else class="primary" bindtap="home">回到做饭</button>
</view><app-tabs active="home"/>
