.cook-shell{height:100vh;display:flex;flex-direction:column;overflow:hidden;padding-bottom:calc(145px + env(safe-area-inset-bottom))}.cook-header{padding:16px 20px 10px;flex-shrink:0}.cook-header .title{font-size:24px;margin:8px 0 16px}.reading{flex:1;height:0;min-height:0}.dish-scroll{width:100%;white-space:nowrap}.dish-rail{display:inline-flex;gap:8px;padding-bottom:6px}.dish-chip{background:#f3f6e8;border:1px solid #c5cfb2;font-size:14px;flex-shrink:0;max-width:280px;white-space:normal;min-height:44px;border-radius:24px;padding:10px 16px}.dish-chip.selected{background:#173d2b;color:#fff;border-color:#173d2b}.article{padding:20px 24px 32px}.recipe-name{font-size:27px;font-weight:600;line-height:1.35;margin-bottom:8px;overflow-wrap:anywhere}.materials-toggle{margin:24px 0 12px;background:transparent;padding:12px 0;display:flex;justify-content:space-between;width:100%;border-bottom:1px solid #c5cfb2;border-radius:0;font-size:15px}.materials-toggle text{font-size:13px;color:#52664b}.step{margin:32px 0 44px}.step-heading{display:flex;gap:12px;align-items:flex-start;margin-bottom:16px}.step-no{font-size:14px;background:#e2ed9c;flex-shrink:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%}.step-title{font-size:20px;font-weight:600;line-height:1.4}.step-text{font-size:18px;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}.step-image{width:100%;height:calc(57.5vw - 27.6px);display:block;border-radius:18px;margin-top:20px;background:#f3f6e8}.image-caption{font-size:11px;color:#52664b;margin:6px 0}.note{background:#e2ed9c;padding:16px;border-radius:16px;font-size:14px}.end{font-size:14px;color:#52664b;padding:24px 0;text-align:center;border-top:1px solid #c5cfb2}.error{margin:0 20px 12px;max-height:110px;overflow:auto;flex-shrink:0}.empty .secondary{margin-top:20px}.card .row{align-items:flex-start}

.dish-chip{transition:background-color 180ms ease-out,border-color 180ms ease-out,color 180ms ease-out,transform 120ms ease-out}
.dish-chip.chip-pressed{transform:scale(.97);opacity:1}
.reading{animation:recipe-arrive 160ms ease-out}
@keyframes recipe-arrive{from{opacity:.55}to{opacity:1}}
.materials-toggle{transition:opacity 140ms ease-out}
.materials-toggle.materials-pressed{opacity:.8}
.materials-panel{animation:materials-arrive 180ms ease-out}
@keyframes materials-arrive{from{opacity:.55}to{opacity:1}}
