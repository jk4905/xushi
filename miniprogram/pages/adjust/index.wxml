<view class="page editor-page"><view wx:if="{{meal}}" class="eyebrow">{{meal.title}}</view><view class="title">按这一餐调整</view><view class="subtitle">只影响这餐。用量有改动时，这项会重新标为待买。</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
 <block wx:if="{{draft}}"><view wx:for="{{rows}}" wx:key="id" class="card ingredient-edit"><view class="section-head"><text class="row-title">{{item.name}}</text><picker range="{{choices}}" value="{{item.choiceIndex}}" data-id="{{item.id}}" bindchange="choice" disabled="{{meal.status !== 'planned'}}"><view class="choice">{{choices[item.choiceIndex]}} ⌄</view></picker></view><view class="muted small">{{item.dish}}</view><input class="input" value="{{item.quantity}}" maxlength="80" placeholder="用量未记录" data-id="{{item.id}}" bindinput="quantity" bindfocus="focus" bindblur="blur" cursor-spacing="36" aria-label="{{item.name}}的本餐用量" disabled="{{meal.status !== 'planned'}}"/><view wx:if="{{item.note}}" class="muted small">{{item.note}}</view></view>
 <view class="card"><view class="section-title">补一项材料</view><input class="input" placeholder="材料名称" maxlength="60" value="{{addName}}" bindinput="name" bindfocus="focus" bindblur="blur" cursor-spacing="36" aria-label="材料名称"/><picker range="{{dishes}}" value="{{dishIndex}}" bindchange="dish"><view class="choice">对应菜品：{{dishes[dishIndex]}} ⌄</view></picker><button class="secondary" hover-stay-time="80" bindtap="add" disabled="{{!addName || meal.status !== 'planned'}}">加入本餐</button></view>
 <view class="field"><label class="label">本餐备注</label><textarea class="textarea" auto-height value="{{draft.notes}}" maxlength="4000" bindinput="notes" bindfocus="focus" bindblur="blur" cursor-spacing="36" aria-label="本餐备注" disabled="{{meal.status !== 'planned'}}"/></view><button class="text-button danger" bindtap="cancel">放弃本次调整</button>
 <view class="bottom-action editor-action {{keyboard ? 'keyboard-action' : ''}}"><button class="primary" hover-stay-time="80" bindtap="save" loading="{{saving}}" disabled="{{saving || meal.status !== 'planned'}}">完成调整</button></view></block>
</view>
